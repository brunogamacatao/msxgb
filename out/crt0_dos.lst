                           000001    72 	.if DOS_PARSEARG
                                     73 		;--- Step 2: Build the parameter pointers table on 0x100,
                                     74 		;    and terminate each parameter with 0.
                                     75 		;    MSX-DOS places the command line length at 0x80 (one byte),
                                     76 		;    and the command line itself at 0x81 (up to 127 characters).
                                     77 
                                     78 		;* Check if there are any parameters at all
      00001A 3A 80 00         [13]   79 		ld		a, (#0x0080)			; Get parameters line length
      00001D B7               [ 4]   80 		or		a
      00001E 0E 00            [ 7]   81 		ld		c, #0					; Initialize parameters counter
      000020 28 4F            [12]   82 		jr		z, crt0_start			; Skip parameters parsing
                                     83 
                                     84 		;* Terminate command line with 0
                                     85 		;  (DOS 2 does this automatically but DOS 1 does not)
      000022 21 81 00         [10]   86 		ld		hl, #0x0081
      000025 ED 4B 80 00      [20]   87 		ld		bc, (#0x0080)
      000029 06 00            [ 7]   88 		ld		b, #0
      00002B 09               [11]   89 		add		hl, bc
      00002C 36 00            [10]   90 		ld		(hl), #0
                                     91 
                                     92 		;* Copy the command line processing code to 0xC000 and
                                     93 		;  execute it from there, this way the memory of the original code
                                     94 		;  can be recycled for the parameter pointers table.
                                     95 		;  (The space from 0x100 up to "cont" can be used,
                                     96 		;   this is room for about 40 parameters.
                                     97 		;   No real world application will handle so many parameters.)
      00002E 21 49 00         [10]   98 		ld		hl, #crt0_param_start
      000031 11 00 C0         [10]   99 		ld		de, #0xC000
      000034 01 28 00         [10]  100 		ld		bc, #crt0_param_end-#crt0_param_start
      000037 ED B0            [21]  101 		ldir
                                    102 
                                    103 		;* Initialize registers and jump to the loop routine
      000039 21 81 00         [10]  104 		ld		hl, #0x0081				; Command line pointer
      00003C 0E 00            [ 7]  105 		ld		c, #0					; Number of params found
      00003E DD 21 00 01      [14]  106 		ld		ix, #0x100				; Params table pointer
                                    107 
      000042 11 71 00         [10]  108 		ld		de, #crt0_start			; To continue execution at "cont"
      000045 D5               [11]  109 		push	de						; when the routine RETs
      000046 C3 00 C0         [10]  110 		jp		0xC000
                                    111 
                                    112 		;>>> Command line processing routine begin
      000049                        113 	crt0_param_start:
                                    114 
                                    115 		;* Loop over the command line: skip spaces
      000049                        116 	crt0_param_loop:
      000049 7E               [ 7]  117 		ld		a, (hl)
      00004A B7               [ 4]  118 		or		a						; Command line end found?
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80), page 20.
Hexadecimal [24-Bits]



      00004B C8               [11]  119 		ret		z
                                    120 
      00004C FE 20            [ 7]  121 		cp		#32
      00004E 20 03            [12]  122 		jr		nz, crt0_param_found
      000050 23               [ 6]  123 		inc		hl
      000051 18 F6            [12]  124 		jr		crt0_param_loop
