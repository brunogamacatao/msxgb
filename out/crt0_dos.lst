                                    287 ;..............................................................................
                                    288 ; V-Blank & H-Blank ISR
                           000000   289 .ifeq ROM_ISR-ISR_VHBLANK
                                    290 .macro INCLUDE_ISR
                                    291 		.globl	_VDP_InterruptHandler
                                    292 		.globl	_VDP_HBlankHandler
                                    293 
                                    294 	crt0_interrupt_start::
                                    295 	; Backup registers
                                    296 		push	af
                                    297 		push	hl
                                    298 		push	de
                                    299 		push	bc
                                    300 		exx
                                    301 		ex		af, af'
                                    302 		push	af
                                    303 		push	hl
                                    304 		push	de
                                    305 		push	bc
                                    306 		push	iy
                                    307 		push	ix
                                    308 	; Reset R#15 to S#0
                                    309 	.if ISR_SET_S0
                                    310 		xor		a
                                    311 		out		(VDP_A), a
                                    312 		ld		a, #(0x80 + 15)
                                    313 		out		(VDP_A),a
                                    314 	.endif
                                    315 	; Check V-Blank
                                    316 		in		a, (VDP_S)					; Get S#0 value
                                    317 		rlca
                                    318 		call	c, _VDP_InterruptHandler 	; Call VDP interruption handler
                                    319 	; Check H-Blank
                                    320 		ld		a, #1
