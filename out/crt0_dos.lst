                                    235 ; V-Blank ISR
                           000001   236 .ifeq ROM_ISR-ISR_VBLANK
                                    237 .macro INCLUDE_ISR
                                    238 		.globl	_VDP_InterruptHandler
                                    239 	crt0_interrupt_start::
                                    240 	; Skip interruptions that do not come from the VDP.
                                    241 		push	af
                                    242 	; Reset R#15 to S#0
                                    243 	.if ISR_SET_S0
                                    244 		xor		a
                                    245 		out		(VDP_A), a
                                    246 		ld		a, #(0x80 + 15)
                                    247 		out		(VDP_A),a
                                    248 	.endif
                                    249 		in		a, (VDP_S)
                                    250 		rlca
                                    251 		jr		nc, crt0_interrupt_skip
                                    252 	; Backup registers
                                    253 		push	hl
                                    254 		push	de
                                    255 		push	bc
                                    256 		exx
                                    257 		ex		af, af'
                                    258 		push	af
                                    259 		push	hl
                                    260 		push	de
                                    261 		push	bc
                                    262 		push	iy
                                    263 		push	ix
                                    264 	; Call VDP interruption handler
                                    265 		call	_VDP_InterruptHandler
                                    266 	; Restore registers
                                    267 		pop		ix
                                    268 		pop		iy
                                    269 		pop		bc
                                    270 		pop		de
                                    271 		pop		hl
                                    272 		pop		af
                                    273 		ex		af, af'
                                    274 		exx
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80), page 10.
Hexadecimal [24-Bits]



                                    275 		pop		bc
                                    276 		pop		de
                                    277 		pop		hl
                                    278 	; Restore registers
                                    279 	crt0_interrupt_skip:
                                    280 		pop		af
                                    281 		ei
                                    282 		reti
                                    283 	crt0_interrupt_end:
                                    284 .endm
                                    285 .endif
