                                    202 ;------------------------------------------------------------------------------
                                    203 ; Delay boot using STKE hook
                                    204 ;------------------------------------------------------------------------------
                                    205 .macro DELAY_BOOT
                                    206 	.if ROM_DELAY
                                    207 	; Setup the hook H.STKE to run the ROM with disk support
                                    208 	crt0_bdos_install:
                                    209 		ld		a, c					; Get the ROM slot number
                                    210 		ld		hl, #crt0_bdos_hook
                                    211 		ld		de, #H_STKE
                                    212 		ld		bc, #4
                                    213 		ldir							; Copy the routine to execute the ROM to the hook
                                    214 		ld		(H_STKE+1), a			; Put the ROM slot number to the hook
                                    215 		ret								; Back to slots scanning
                                    216 
                                    217 	; Routine to execute the ROM
                                    218 	crt0_bdos_hook:
                                    219 		rst		0x30					; Inter-slot call
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80), page 9.
Hexadecimal [24-Bits]



                                    220 		.db		1						; This byte will be replaced by the slot number of ROM
                                    221 		.dw		crt0_bdos_end			; Address to execute the ROM
                                    222 
                                    223 	; Remove the hook and resume the ROM boot sequence
                                    224 	crt0_bdos_end:
                                    225 		ld		a, #0xC9				; 'ret' instruction
                                    226 		ld		(H_STKE), a
                                    227 	.endif
                                    228 .endm
