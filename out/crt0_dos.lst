                                    173 ;------------------------------------------------------------------------------
                                    174 ; Set page #0 at the same slot than the page #3 (replace Main-ROM by RAM)
                                    175 ; /!\ Need 64 KB of RAM
                                    176 ;------------------------------------------------------------------------------
                                    177 .macro INIT_P3_TO_P0
                                    178 
                                    179 	crt0_p3_to_p0:
                                    180 		; Set pages #0 primary slot equal to page #3 one
                                    181 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info 
                                    182 		and		a, #0b11111100			; A=[P3|P2|P1|00] Mask P0 slot 
                                    183 		ld		b, a					; B=[P3|P2|P1|00] Backup
                                    184 		and		a, #0b11000000			; A=[P3|00|00|00] Mask all pages slots but P3 
                                    185 		rlca							;                 A<<1
                                    186 		rlca							; A=[00|00|00|P3] A<<1
                                    187 		or		a, b					; A=[P3|P2|P1|P3] Merge
                                    188 		out		(PPI_A), a				;                 Set primary slots info
                                    189 
                                    190 		; Set page #0 seconday slot equal to page #3 one
                                    191 		ld		a, (SLTSL)				; A=[~3|~2|~1|~0] Read secondary slots register of selected primary slot
                                    192 		cpl								; A=[S3|S2|S1|S0] Reverses the bits
                                    193 		and		a, #0b11111100			; A=[S3|S2|S1|00] Mask S0 slot 
                                    194 		ld		b, a					; B=[S3|S2|S1|00] Backup
                                    195 		and		a, #0b11000000			; A=[S3|00|00|00] Mask all pages slots but S3 
                                    196 		rlca							;                 A<<1
                                    197 		rlca							; A=[00|00|00|S3] A<<1
                                    198 		or		a, b					; A=[S3|S2|S1|S3] Merge
                                    199 		ld		(SLTSL), a				;                 Set secondary slot info
                                    200 .endm
