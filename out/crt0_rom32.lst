                                    352 ; V9990 ISR
                           000000   353 .ifeq ROM_ISR-ISR_V9990
                                    354 .macro INCLUDE_ISR
                                    355 		.globl	_V9_InterruptVBlank
                                    356 		.globl	_V9_InterruptHBlank
                                    357 		.globl	_V9_InterruptCommand
                                    358 
                                    359 	crt0_interrupt_start::
                                    360 	; Skip interruptions that do not come from the VDP.
                                    361 		push	af
                                    362 		in		a, (V9_P06)
                                    363 		or		a
                                    364 		jr		z, crt0_interrupt_skip ; Quick skip (before full register backup)
                                    365 	; Backup registers
                                    366 		push	hl
                                    367 		push	de
                                    368 		push	bc
                                    369 		exx
                                    370 		ex		af, af'
                                    371 		push	af
                                    372 		push	hl
                                    373 		push	de
                                    374 		push	bc
                                    375 		push	iy
                                    376 		push	ix
                                    377 	; Call VDP interruption handler
                                    378 		in		a, (V9_P06)			; Get P#6 again (quicker than push/pop the value)
                                    379 		out		(V9_P06), a			; Reset interrupt bits
                                    380 	; V-Blank interruption
                                    381 		rra
                                    382 		call	c, _V9_InterruptVBlank
                                    383 	; H-Blank interruption
                                    384 		rra
