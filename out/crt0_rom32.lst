                                     92 ;------------------------------------------------------------------------------
                                     93 ; Set page #2 at the same slot than the page #1 (for 32K ROM)
                                     94 ;------------------------------------------------------------------------------
                                     95 .macro INIT_P1_TO_P2
                                     96 
                                     97 	crt0_p1_to_p2:
                                     98 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
                                     99 		rrca
                                    100 		rrca							; A=[P0|P3|P2|P1]
                                    101 		and		a, #0b00000011			; A=[00|00|00|P1] Save Page 1 primary slot
                                    102 		ld		c, a					; C=[00|00|00|P1]
                                    103 		ld		hl, #EXPTBL				; HL=&EXPTBL
                                    104 		add		a, l
                                    105 		ld		l, a
                                    106 		ld		a, (hl)					; A=EXPTBL[P1]    See if the slot is expanded or not
                                    107 		and		a, #0x80				; A=[X|000|00|00] Keep only expansion flag
                                    108 		or		a, c					; A=[X|000|00|P1] Set MSB if so
                                    109 		ld		c, a					; C=[X|000|00|P1] Save it to [C]
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80), page 7.
Hexadecimal [24-Bits]



                                    110 		inc		l						;                 Point to primary slot's SLTTBL entry
                                    111 		inc		l
                                    112 		inc		l
                                    113 		inc		l
                                    114 		ld		a, (hl)					; A=SLTTBL[P1]    Get what is currently output to expansion slot register
                                    115 		and		a, #0b00001100			; A=[00|00|S1|00]
                                    116 		or		c						; A=[X|000|S1|P1] Finally form slot address
                                    117 		ld		h, #0x80				; H=Page 2
                                    118 		call	ENASLT					;                 Enable page 1's slot in page 2
                                    119 .endm
                                    120 
                                    121 ;------------------------------------------------------------------------------
                                    122 ; Set pages #0 and #2 at the same slot than the page #1 (for 48K ROM)
                                    123 ;------------------------------------------------------------------------------
                                    124 .macro INIT_P1_TO_P02
                                    125 
                                    126 	crt0_p1_to_p02:
                                    127 		; Set all pages primary slot equal to page #1 one
                                    128 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
                                    129 		ld		d, a					; D=[P3|P2|P1|P0] Backup full slots info
                                    130 		and		a, #0b00001100			; A=[00|00|P1|00] Mask all pages slots but P1 
                                    131 		ld		c, a					; C=[00|00|P1|00] Backup P1
                                    132 		rrca							;                 A>>1
                                    133 		rrca							; A=[00|00|00|P1] A>>1
                                    134 		or		a, c					; A=[00|00|P1|P1]
                                    135 		ld		c, a					; C=[00|00|P1|P1] Backup 
                                    136 		add		a, a					;                 A<<1
                                    137 		add		a, a					; A=[00|P1|P1|00] A<<1
                                    138 		add		a, a					;                 A<<1
                                    139 		add		a, a					; A=[P1|P1|00|00] A<<1
                                    140 		or		a, c					; A=[P1|P1|P1|P1] Merge
                                    141 		out		(PPI_A), a				;                 Set primary slots info
                                    142 		ld		e, a					; E=[P1|P1|P1|P1] Backup new slots
                                    143 
                                    144 		; Set page #0 and 2 at the same secondary slot than page #1 one
                                    145 		ld		a, (SLTSL)				; A=[~3|~2|~1|~0] Read secondary slots register of selected primary slot
                                    146 		cpl								; A=[S3|S2|S1|S0] Reverses the bits
                                    147 		ld		b, a					; B=[S3|S2|S1|S0] Backup secondary slot
                                    148 		and		a, #0b00001100			; A=[00|00|S1|00] Mask all pages secondary slots but P1 
                                    149 		ld		c, a					; C=[00|00|S1|00] Backup
                                    150 		rrca							;                 A>>1
                                    151 		rrca							; A=[00|00|00|S1] A>>1
                                    152 		or		a, c					; A=[00|00|S1|S1] Merge
                                    153 		ld		c, a					; C=[00|00|S1|S1] Backup
                                    154 		add		a, a					;                 A<<1
                                    155 		add		a, a					; A=[00|S1|S1|00] A<<1
                                    156 		or		a, c					; A=[00|S1|S1|S1] Merge
                                    157 		ld		c, a					; C=[00|S1|S1|S1] Backup
                                    158 		ld		a, b					; A=[S3|S2|S1|S0] Restore primary slots info 
                                    159 		and		a, #0b11000000			; A=[S3|00|00|00] Mask all pages slots but P0 
                                    160 		or		a, c					; A=[S3|S1|S1|S0] Merge original P0 and P1 in all other page
                                    161 		ld		(SLTSL), a				;                 Set secondary slot info
                                    162 
                                    163 		; Restore initial Page 3 slot
                                    164 		ld		a, d					; A=[P3|P2|P1|P0] Restore initiale primary slots
ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80), page 8.
Hexadecimal [24-Bits]



                                    165 		and		a, #0b11000000			; A=[P3|00|00|00] Keep page #3 primary slot
                                    166 		ld		c, a					; C=[P3|00|00|00] Backup
                                    167 		ld		a, e					; A=[P1|P1|P1|P1] Restore new primary slots
                                    168 		and		a, #0b00111111			; A=[00|P1|P1|P1] Keep all pages but page #3
                                    169 		or		a, c					; A=[P3|P1|P1|P1] Merge
                                    170 		out		(PPI_A), a				;                 Set primary slots info
                                    171 .endm
